# -----------------------------------------------------------------------------
# Durabull Environment Configuration
# -----------------------------------------------------------------------------
# 1) Copy this file to `.env`
# 2) Fill in values as needed (leave optional values blank)
# 3) Keep `.env` private — it is gitignored
# -----------------------------------------------------------------------------

# Optional: authless mode (disables login and auto-creates a local admin)
# SECURITY WARNING: Never expose authless mode to the public internet.
# Use only in local development or private networks with external access controls.
# DURABULL_AUTHLESS=true
# MCP_AUTHLESS_BEARER_TOKEN=use-a-long-random-string-for-local-mcp
# Optional: force env-based connections even when DATABASE_URL is set
# DURABULL_ENV_CONNECTIONS=true

# -----------------------------------------------------------------------------
# Env-Driven Redis Connections (works in authenticated or authless mode)
# Pattern:
#   DURABULL_REDIS_URL_{NAME}=redis://...
#   DURABULL_REDIS_URL_{NAME}_ENVIRONMENT=production|staging|development
#   DURABULL_REDIS_URL_{NAME}_ALLOW_SELF_SIGNED_CERTS=true|false
#   DURABULL_REDIS_URL_DEFAULT={NAME}
# -----------------------------------------------------------------------------
# DURABULL_REDIS_URL_MAIN=redis://localhost:6379
# DURABULL_REDIS_URL_MAIN_ENVIRONMENT=development
# DURABULL_REDIS_URL_WORKERS=redis://localhost:6380
# DURABULL_REDIS_URL_WORKERS_ENVIRONMENT=staging
# DURABULL_REDIS_URL_DEFAULT=MAIN

# -----------------------------------------------------------------------------
# Fleet Demo Workload App (packages/fleet-demo-workload)
# Uses a single logical workload connection
# -----------------------------------------------------------------------------
# WORKLOAD_REDIS_URL=redis://localhost:6379
# WORKLOAD_METRICS_MAX_DATA_POINTS=20160
# WORKLOAD_HEARTBEAT_MS=60000
# WORKLOAD_LOG_LEVEL=info
# WORKLOAD_NAMESPACE_QUEUES=true

# -----------------------------------------------------------------------------
# Stateful Persistence Mode (Postgres + org-scoped connections)
# -----------------------------------------------------------------------------
# Host port published by tooling/docker/docker-compose.yaml for Postgres.
# Change this if another local stack already uses the default.
DURABULL_POSTGRES_PORT=55432
# Host port mapped to Docker Redis (container still uses 6379 internally). Default 56379 avoids clashes with another Redis on 6379. `bun docker` passes --env-file .env so this file is applied (Compose alone only reads tooling/docker/.env).
DURABULL_REDIS_PORT=56379
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/durabull
REDIS_URL=redis://localhost:56379
# Demo account Redis seed (`bun docker:seed:demo`) — must match Docker Redis host port above.
# DURABULL_DEMO_ACCOUNT_REDIS_CONNECTION_STRING=redis://localhost:56379
# Required when Redis connection URLs are persisted in the database.
# Generate with: openssl rand -hex 32
DURABULL_REDIS_URL_ENCRYPTION_KEY=replace-with-64-char-hex-key
# Required when secrets are persisted in the database.
# Generate with: openssl rand -hex 32
DURABULL_SECRET_ENCRYPTION_KEY=replace-with-64-char-hex-key

# Stateless Persistence Mode:
# - Leave DATABASE_URL unset to use local PGlite persistence at ./data/pglite

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# PORT=3001
# NODE_ENV=development

# -----------------------------------------------------------------------------
# Auth + App URLs
# -----------------------------------------------------------------------------
APP_BASE_URL=http://localhost:5173
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string

# OAuth (optional)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Email (optional)
# -----------------------------------------------------------------------------
# RESEND_API_KEY=
# Override the From address used for invitation and alert emails. Required when
# self-hosting against a Resend account that does not own durabull.io.
# Format: "Display Name <user@your-verified-domain.example>"
# EMAIL_FROM=Acme Ops <ops@acme.example>

# -----------------------------------------------------------------------------
# Telemetry (cloud / managed PostHog ingest)
# -----------------------------------------------------------------------------
# Required on Durabull Cloud and any host that ingests /api/telemetry/collect.
# DURABULL_TELEMETRY_HMAC_SECRET=<long-random-secret>
# DURABULL_TELEMETRY_COLLECT_SECRET=<long-random-secret>
# DURABULL_TELEMETRY_POSTHOG_KEY=
# DURABULL_TELEMETRY_POSTHOG_HOST=https://us.i.posthog.com

# -----------------------------------------------------------------------------
# Linear
# -----------------------------------------------------------------------------
# LINEAR_OAUTH_CLIENT_ID=
# LINEAR_OAUTH_CLIENT_SECRET=
# LINEAR_OAUTH_REDIRECT_URI=
# Optional: use app-actor OAuth mode by setting this to app.
# LINEAR_OAUTH_ACTOR=user

# -----------------------------------------------------------------------------
# Alerting (optional)
# -----------------------------------------------------------------------------
# DURABULL_ALERT_ENABLED=true
# DURABULL_ALERT_POLL_INTERVAL_MS=60000
# DURABULL_ALERT_JOB_RESOLVE_INTERVAL_MS=300000
# DURABULL_WEBHOOK_ALLOW_HTTP=false

# -----------------------------------------------------------------------------
# Public (Client) Environment Variables
# VITE_ prefixed values are exposed to browser clients in both apps.
# -----------------------------------------------------------------------------
VITE_PUBLIC_APP_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# PostHog Analytics (optional)
# The web app fetches PostHog config from the API (/api/app/config).
# Only server-side env vars are needed — no VITE_ prefix required.
# Configuring POSTHOG_KEY sends the full PostHog browser analytics stream to
# your own PostHog project; it does not disable Durabull's mandatory
# anonymous/pseudonymous product telemetry.
# -----------------------------------------------------------------------------
# POSTHOG_KEY=phc_your_posthog_project_key
# PostHog upstream host used by the API reverse proxy (/ingest -> POSTHOG_HOST)
# Must point to PostHog ingestion host, not your app/proxy URL.
# US Cloud: https://us.i.posthog.com  (default)
# EU Cloud: https://eu.i.posthog.com
# POSTHOG_HOST=https://us.i.posthog.com

# -----------------------------------------------------------------------------
# Durabull Anonymous Usage Telemetry
# Production/self-hosted Durabull collects anonymous/pseudonymous usage telemetry
# to understand feature usage and improve the product. Durabull does not collect
# Redis URLs, queue names, Redis key names, job data, logs, emails, names,
# organizations, or raw error messages.
# No separate collector service or telemetry hostname is required for self-hosted
# deployments; sanitized telemetry is forwarded to Durabull's existing cloud API.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Optional Runtime Toggles
# -----------------------------------------------------------------------------
# DISABLE_RATE_LIMIT=true
# ASSET_PRELOAD_MAX_SIZE=5242880
# ASSET_PRELOAD_VERBOSE_LOGGING=false
