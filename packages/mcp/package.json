{
  "name": "@durabull/mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./auth": {
      "types": "./src/auth/index.ts",
      "import": "./src/auth/index.ts"
    },
    "./testing": {
      "types": "./src/testing/mcp-test-client.ts",
      "import": "./src/testing/mcp-test-client.ts"
    },
    "./safety/sanitize-output": {
      "types": "./src/safety/sanitize-output.ts",
      "import": "./src/safety/sanitize-output.ts"
    }
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "format": "biome format --write ./src",
    "format:check": "biome format ./src",
    "build:app": "bun scripts/build-app.ts",
    "check:app": "bun scripts/build-app.ts --check",
    "preview:app": "bun scripts/preview-app.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "2.3.1",
    "@openai/apps-sdk-ui": "0.2.2",
    "hono": "^4.6.14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/bun": "^1.3.8",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.2",
    "vite": "^7.1.7"
  }
}
