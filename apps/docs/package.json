{
  "name": "@durabull/docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run search:index && next dev --port 3002",
    "search:index": "bun x fumadocs-mdx && bun tooling/generate-search-index.ts && bun tooling/generate-llms-txt.ts",
    "build": "bun run search:index && NEXT_OUTPUT=export next build",
    "build:server": "bun run search:index && next build",
    "start": "bun x serve out",
    "start:server": "next start",
    "typecheck": "bun run search:index && tsc --noEmit",
    "lint": "biome lint ./src ./app",
    "lint:fix": "biome lint --write ./src ./app",
    "format": "biome format --write ./src ./app",
    "format:check": "biome format ./src ./app"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.1.6",
    "@next/third-parties": "^15.3.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "fumadocs-core": "15.8.5",
    "fumadocs-mdx": "^14.2.7",
    "fumadocs-ui": "15.8.5",
    "geist": "^1.3.1",
    "lucide-react": "^0.468.0",
    "next": "^15.3.0",
    "posthog-js": "1.351.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.2"
  }
}
