{
  "name": "@durabull/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./app": {
      "types": "./src/app.ts",
      "import": "./src/app.ts"
    }
  },
  "scripts": {
    "predev": "bun run clear-port-3001",
    "dev": "bun --watch src/index.ts",
    "clear-port-3001": "if [ -n \"$SKIP_CLEAR_PORT_3001\" ]; then echo 'Skipping clear-port-3001'; else lsof -ti:3001 | xargs kill -9 2>/dev/null || echo 'No process found on port 3001'; fi",
    "build": "bun scripts/build.ts",
    "start": "bun src/index.ts",
    "start:built": "bun dist/index.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src ./scripts",
    "lint:fix": "biome lint --write ./src ./scripts",
    "format": "biome format --write ./src ./scripts",
    "format:check": "biome format ./src ./scripts"
  },
  "dependencies": {
    "@durabull/auth": "workspace:*",
    "@durabull/analytics": "workspace:*",
    "@durabull/dal": "workspace:*",
    "@durabull/env": "workspace:*",
    "@durabull/mcp": "workspace:*",
    "@durabull/email": "workspace:*",
    "@hono/zod-validator": "^0.4.2",
    "better-auth": "^1.4.9",
    "bullmq": "^5.34.8",
    "drizzle-orm": "^1.0.0-beta.9-e89174b",
    "hono": "^4.6.14",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2"
  }
}
